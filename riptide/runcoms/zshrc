# Activate virtualenv in a git repo: a .venv dir, a .venv file naming a pyenv
# env, or a pyenv env named like the repo.
function workon_cwd {
  if [[ -z "$WORKON_CWD" ]]; then
    local WORKON_CWD=1
    # Check if this is a Git repo
    local GIT_REPO_ROOT=""
    local GIT_TOPLEVEL="$(git rev-parse --show-toplevel 2> /dev/null)"
    if [[ $? == 0 ]]; then
      GIT_REPO_ROOT="$GIT_TOPLEVEL"
    fi
    # Get absolute path, resolving symlinks
    local PROJECT_ROOT="${PWD:A}"
    while [[ "$PROJECT_ROOT" != "/" && ! -e "$PROJECT_ROOT/.venv" \
             && ! -d "$PROJECT_ROOT/.git"  && "$PROJECT_ROOT" != "$GIT_REPO_ROOT" ]]; do
      PROJECT_ROOT="${PROJECT_ROOT:h}"
    done
    if [[ "$PROJECT_ROOT" == "/" ]]; then
      PROJECT_ROOT="."
    fi
    # Check for virtualenv name override
    local ENV_NAME
    if [[ -f "$PROJECT_ROOT/.venv" ]]; then
      ENV_NAME="$(cat "$PROJECT_ROOT/.venv")"
    elif [[ -f "$PROJECT_ROOT/.venv/bin/activate" ]]; then
      ENV_NAME="$PROJECT_ROOT/.venv"
    elif [[ "$PROJECT_ROOT" != "." ]]; then
      ENV_NAME="${PROJECT_ROOT:t}"
    else
      ENV_NAME=""
    fi
    if [[ "$ENV_NAME" != "" ]]; then
      # Activate the environment only if it is not already active
      if [[ -f "$ENV_NAME/bin/activate" ]]; then
        # A committed activate script is someone else's code: don't run it.
        if [[ -n $GIT_REPO_ROOT ]] && git -C "$PROJECT_ROOT" ls-files \
            --error-unmatch "$ENV_NAME/bin/activate" &> /dev/null; then
          print -u2 "workon_cwd: $ENV_NAME/bin/activate is tracked in git, skipped"
        elif [[ "$VIRTUAL_ENV" != "${ENV_NAME:A}" ]]; then
          source "$ENV_NAME/bin/activate" && export CD_VIRTUAL_ENV="$ENV_NAME"
        fi
      elif (( $+commands[pyenv] )) && [[ "$VIRTUAL_ENV" != */"$ENV_NAME" ]]; then
        pyenv activate "$ENV_NAME" 2> /dev/null && export CD_VIRTUAL_ENV="$ENV_NAME"
      fi
    elif [[ -n $CD_VIRTUAL_ENV && -n $VIRTUAL_ENV ]]; then
      # We've just left the repo, deactivate the environment
      # Note: this only happens if the virtualenv was activated automatically
      if (( $+functions[deactivate] )); then
        deactivate
      else
        pyenv deactivate
      fi
      unset CD_VIRTUAL_ENV
    fi
  fi
}

# Disabled: sourcing any ./.env on cd runs code from whatever you cd into.
# Run it by hand if needed.
function auto_env {
  # not ideal, .env became a convention after i used it as .sh files.
  if [[ -s "./.env" ]]; then
    source .env
  fi
}

# Append workon_cwd to the chpwd_functions array, so it will be called on cd
# http://zsh.sourceforge.net/Doc/Release/Functions.html
if ! (( $chpwd_functions[(I)workon_cwd] )); then
  chpwd_functions+=(workon_cwd)
fi

# Commit with a past date, default 10 hours ago: commitold -2d, -30M, -3H.
function commitold {
  local off=${1:--10H} _dt y=y
  if [[ "$OSTYPE" == darwin* ]]; then
    _dt=$(date -v$off "+%c +0530")
  else
    local -A units=(S seconds M minutes H hours d days m months y years)
    _dt=$(date -d "${off%?} ${units[${off[-1]}]}" "+%c +0530")
  fi
  vared -p "Create a commit on ${_dt}? " y
  if [[ $y == y ]]; then
    GIT_AUTHOR_DATE=$_dt GIT_COMMITTER_DATE=$_dt git commit
  fi
}

