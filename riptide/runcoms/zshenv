# The repo root, found through the ~/.zshenv symlink (riptide/runcoms/zshenv).
export DOTFILEDIR="${DOTFILEDIR:-${${(%):-%x}:A:h:h:h}}"

# Debian/Ubuntu's /etc/zsh/zshrc runs compinit too; Prezto does it (cached).
skip_global_compinit=1

# Ensure that a non-login, non-interactive shell has a defined environment.
if [[ ( "$SHLVL" -eq 1 && ! -o LOGIN ) && -s "${ZDOTDIR:-$HOME}/.zprofile" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprofile"
fi
