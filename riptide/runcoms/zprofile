#
# Executes commands at login pre-zshrc.
# Secrets and host-only bits go in ~/.zprofile.local (not in the repo).
#

#
# Browser, editors
#

if [[ "$OSTYPE" == darwin* ]]; then
  export BROWSER='open'
fi

if (( $+commands[nvim] )); then
  export EDITOR='nvim'
elif (( $+commands[vim] )); then
  export EDITOR='vim'
else
  export EDITOR='nano'
fi
export VISUAL="$EDITOR"
export PAGER='less'

#
# Language
#

if [[ -z "$LANG" ]]; then
  export LANG='en_US.UTF-8'
fi

#
# Paths
#

typeset -gU cdpath fpath mailpath path

export GOPATH="$HOME/.go"

# (N) drops dirs that don't exist on this host.
path=(
  $HOME/.rbenv/bin(N)
  /usr/local/{bin,sbin}(N)
  $path
  $HOME/.poetry/bin(N)
  $HOME/opt/bin(N)
  $DOTFILEDIR/bin
  $HOME/.local/bin(N)
)

# Homebrew (Apple silicon, then Intel), prepended last so it wins.
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  if [[ -x $_brew ]]; then
    eval "$($_brew shellenv)"
    break
  fi
done
unset _brew

#
# Less
#

# Mouse-wheel scrolling is on (no -X); -F exits if the content fits one screen.
export LESS='-F -g -i -M -R -S -w -z-4'

# Set the Less input preprocessor.
# Try both `lesspipe` and `lesspipe.sh` as either might exist on a system.
if (( $#commands[(i)lesspipe(|.sh)] )); then
  export LESSOPEN="| /usr/bin/env $commands[(i)lesspipe(|.sh)] %s 2>&-"
fi

#
# Temporary Files
#

# /tmp/$LOGNAME must be ours: on a shared host anyone could pre-create it.
if [[ ! -d "$TMPDIR" ]]; then
  export TMPDIR="/tmp/$LOGNAME"
  mkdir -p -m 700 "$TMPDIR" 2>/dev/null
  if [[ ! -O "$TMPDIR" || -L "$TMPDIR" ]]; then
    export TMPDIR="$(mktemp -d)"
  fi
fi

TMPPREFIX="${TMPDIR%/}/zsh"

#
# Tools
#

# venv activate scripts (uv, venv) must not add "(name)": the prompt shows it.
export VIRTUAL_ENV_DISABLE_PROMPT=1

export PICO_SDK_PATH="$HOME/repo/hw/pico/pico-sdk"

# Host-only: tokens (HOMEBREW_GITHUB_API_TOKEN, ...), extra paths.
if [[ -s "${ZDOTDIR:-$HOME}/.zprofile.local" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprofile.local"
fi
