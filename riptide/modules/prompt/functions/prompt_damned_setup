# Load dependencies.
pmodload 'helper'

function prompt_damned_pwd {
  local pwd="${PWD/#$HOME/~}"

  if [[ "$pwd" == (#m)[/~] ]]; then
    _prompt_damned_pwd="$MATCH"
    unset MATCH
  else
    _prompt_damned_pwd="${${${${(@j:/:M)${(@s:/:)pwd}##.#?}:h}%/}//\%/%%}/${${pwd:t}//\%/%%}"
  fi
}

function prompt_damned_right_info {
  if (( _prompt_damned_precmd_async_pid > 0 )); then
    # Append Git status.
    if [[ -s "$_prompt_damned_precmd_async_data" ]]; then
      alias typeset='typeset -g'
      source "$_prompt_damned_precmd_async_data"
      RPROMPT+='${git_info:+${(e)git_info[status]}}'
      RPROMPT+='${python_info:+${(e)python_info[virtualenv]}}'
      unalias typeset
    fi

    # Reset PID.
    _prompt_damned_precmd_async_pid=0

    # Redisplay prompt.
    zle && zle reset-prompt
  fi
}

function prompt_damned_precmd_async {
  # Start empty: an untrusted repo must not show the last trusted result.
  : >! "$_prompt_damned_precmd_async_data"

  # Get Git repository information, trusted repos only (see prompt_damned_git_trust).
  # core.fsmonitor forced off: a repo config could make it run any command.
  if (( $+functions[git-info] && _prompt_damned_git_trusted )); then
    GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.fsmonitor GIT_CONFIG_VALUE_0=false \
      git-info
    typeset -p git_info >> "$_prompt_damned_precmd_async_data"
  fi

  if (( $+functions[python-info] )); then
    python-info
    typeset -p python_info >> "$_prompt_damned_precmd_async_data"
  fi

  # Signal completion to parent process.
  kill -WINCH $$
}

function prompt_damned_precmd {
  setopt LOCAL_OPTIONS
  unsetopt XTRACE KSH_ARRAYS

  # Drop git info left over from a trusted repo.
  (( _prompt_damned_git_trusted )) || unset git_info

  # Format PWD.
  prompt_damned_pwd

  # Define prompts.
  # RPROMPT='${editor_info[overwrite]}%(?:: %F{1}⏎%f)${VIM:+" %B%F{6}V%f%b"}'
  RPROMPT=''

  # Kill the old process of slow commands if it is still running.
  if (( _prompt_damned_precmd_async_pid > 0 )); then
    kill -KILL "$_prompt_damned_precmd_async_pid" &>/dev/null
  fi

  # Compute slow commands in the background.
  trap prompt_damned_right_info WINCH
  prompt_damned_precmd_async &!
  _prompt_damned_precmd_async_pid=$!
}

# git status runs config from the repo (fsmonitor, filters), so it only runs
# where a remote matches ':prezto:module:prompt:damned:git' trusted patterns.
# Runs on cd; reading config executes nothing.
function prompt_damned_git_trust {
  _prompt_damned_git_trusted=0
  local -a patterns urls
  local url pattern
  zstyle -a ':prezto:module:prompt:damned:git' trusted 'patterns'
  (( $#patterns )) || return 0
  urls=(${(f)"$(command git config --local --get-regexp '^remote\..*\.url$' 2> /dev/null)"})
  for url in ${urls#* }; do
    for pattern in $patterns; do
      if [[ $url == ${~pattern} ]]; then
        _prompt_damned_git_trusted=1
        return 0
      fi
    done
  done
}

function prompt_damned_exit {
  rm -f "$_prompt_damned_precmd_async_data"
}

function prompt_damned_setup {
  setopt LOCAL_OPTIONS
  unsetopt XTRACE KSH_ARRAYS
  prompt_opts=(cr percent subst)
  _prompt_damned_precmd_async_pid=0
  # One file per shell, else concurrent shells read each other's git status.
  _prompt_damned_precmd_async_data="${TMPPREFIX:-/tmp/zsh}-prompt_damned_data.$$"

  # Host segment, see ':prezto:module:prompt:damned:host' in .zpreztorc.
  # show: 'ssh' (default) over SSH only, 'always' or 'never'.
  # class: a key of 'colors' or a 0-255 color; default is the hostname prefix
  # (pi-diserver -> pi), falling back to 'other'.
  local show_host host_class host_color
  local -A host_colors
  zstyle -s ':prezto:module:prompt:damned:host' show 'show_host' || show_host='ssh'
  zstyle -a ':prezto:module:prompt:damned:host' colors 'host_colors'
  zstyle -s ':prezto:module:prompt:damned:host' class 'host_class' \
    || host_class=${HOST%%[-._0-9]*}
  if [[ $host_class == <0-255> ]]; then
    host_color=$host_class
  else
    host_color=${host_colors[$host_class]:-${host_colors[other]:-60}}
  fi
  _prompt_damned_host=''
  if [[ $show_host == always || ( $show_host == ssh && -n $SSH_CONNECTION ) ]]; then
    _prompt_damned_host="%K{$host_color}%F{252} %m %K{238}%F{$host_color}%f"
  fi

  # Load required functions.
  autoload -Uz add-zsh-hook

  # Add hook for calling git-info before each command.
  add-zsh-hook precmd prompt_damned_precmd
  add-zsh-hook zshexit prompt_damned_exit
  add-zsh-hook chpwd prompt_damned_git_trust
  prompt_damned_git_trust

  # Set editor-info parameters.
  zstyle ':prezto:module:editor:info:completing' format '%B%F{red}...%f%b'
  zstyle ':prezto:module:editor:info:keymap:primary' format '%F{cyan}❯%f'
  zstyle ':prezto:module:editor:info:keymap:primary:overwrite' format '%F{red}♺%f'
  zstyle ':prezto:module:editor:info:keymap:alternate' format '%B%F{red}❮%f%b'

  # Set git-info parameters.
  zstyle ':prezto:module:git:info' verbose 'yes'
  zstyle ':prezto:module:git:info:branch' format '%F{2}⧺%f %F{2}%b%f'
  zstyle ':prezto:module:git:info:added' format '%F{5}≙%f'
  zstyle ':prezto:module:git:info:modified' format '%F{1}≛%f'
  zstyle ':prezto:module:git:info:ahead' format '%F{4}↑%f '
  zstyle ':prezto:module:git:info:behind' format '%F{4}↓%f '


  zstyle ':prezto:module:git:info:keys' format \
    'status' '%A%B%a%m%c%b'

  zstyle ':prezto:module:python:info:virtualenv' format \
    ' %F{14}⑉%f%F{5}%v%f'

  # Define prompts.
  PROMPT='${_prompt_damned_host}%K{238}%F{252} $_prompt_damned_pwd %f%k%F{238}%f'
  PROMPT+='${editor_info[keymap]} '
  RPROMPT=''
  SPROMPT='bruh, correct %F{1}%R%f to %F{2}%r%f [nyae]? '
}

function prompt_damned_preview {
  local +h PROMPT=''
  local +h RPROMPT=''
  local +h SPROMPT=''

  editor-info 2>/dev/null
  prompt_preview_theme 'damned'
}

prompt_damned_setup "$@"
