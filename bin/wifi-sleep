#!/usr/bin/env bash
# macOS: Wi-Fi off while asleep, back on when the display wakes.
# Works around bcmwlan panics on dark wakes ("IOUserServer(com.apple.bcmwlan)
# has crashed too many times"). Find My still works over Bluetooth.
#   wifi-sleep install | uninstall | status
# Runs sleepwatcher from a LaunchAgent; ~/.sleep and ~/.wakeup are untouched.
# On wake, Wi-Fi only comes back if this script turned it off.
set -euo pipefail

label=pw.noop.wifi-sleep
plist=$HOME/Library/LaunchAgents/$label.plist
state=${TMPDIR:-/tmp}/$label.off
self=$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")

[[ $(uname) == Darwin ]] || { echo "macOS only" >&2; exit 1; }

dev() {
  networksetup -listallhardwareports |
    awk '/^Hardware Port: (Wi-Fi|AirPort)/{getline; print $2; exit}'
}

power() { networksetup -getairportpower "$(dev)" | awk '{print $NF}'; }

case ${1:-status} in
  off)  # sleepwatcher -s: system is going to sleep
    if [[ $(power) == On ]]; then
      networksetup -setairportpower "$(dev)" off && touch "$state"
    fi ;;
  on)  # sleepwatcher -W: display woke, i.e. a real wake, not a dark wake
    if [[ -e $state ]]; then
      rm -f "$state"
      networksetup -setairportpower "$(dev)" on
    fi ;;
  install)
    command -v brew >/dev/null || { echo "needs Homebrew" >&2; exit 1; }
    sw=$(brew --prefix)/sbin/sleepwatcher
    [[ -x $sw ]] || brew install sleepwatcher
    [[ -n $(dev) ]] || { echo "no Wi-Fi interface found" >&2; exit 1; }
    mkdir -p "$(dirname "$plist")"
    cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>$sw</string>
    <string>-s</string><string>$self off</string>
    <string>-W</string><string>$self on</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict>
</plist>
EOF
    launchctl bootout "gui/$UID/$label" 2>/dev/null || true
    launchctl bootstrap "gui/$UID" "$plist"
    echo "installed: Wi-Fi ($(dev)) goes off on sleep, on at display wake" ;;
  uninstall)
    launchctl bootout "gui/$UID/$label" 2>/dev/null || true
    rm -f "$plist"
    [[ -e $state ]] && "$self" on
    echo "uninstalled" ;;
  status)
    if launchctl print "gui/$UID/$label" >/dev/null 2>&1; then
      echo "agent: running"
    else
      echo "agent: not installed (wifi-sleep install)"
    fi
    echo "wifi $(dev): $(power)$([[ -e $state ]] && echo ', off by wifi-sleep')" ;;
  *) sed -n 5p "$0" >&2; exit 2 ;;
esac
