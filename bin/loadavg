#!/usr/bin/env bash

# 1-min load: /proc on Linux, sysctl on macOS.
if [[ -r /proc/loadavg ]]; then
  read -r l _ < /proc/loadavg
else
  l=$(sysctl -n vm.loadavg | awk '{print $2}')
fi

echo "load averages: $l" | \
  awk '
    {printf("%.1f %s",
      $3,
      ($3 > 3.0) ? "f2854a" : \
        ($3 > 2.5) ? "d6556d" : \
          ($3 > 2.0) ? "ae2791" : \
            ($3 > 1.5) ? "0781a8" : "7081a8")
    }' | \
  awk '{printf "#[fg=#%s]#[fg=#ffffff,bg=#%s]⌁ %s ", $2, $2, $1}'
